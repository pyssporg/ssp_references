    <ssv:Parameter name="d_B">
      <ssv:Real value="2" />
    </ssv:Parameter>
    <ssv:Parameter name="KqMO_PABT_gain">
      <ssv:Real value="1" />
    </ssv:Parameter>
    <ssv:Parameter name="KqMI_PABT_gain">
      <ssv:Real value="1" />
    </ssv:Parameter>
    <ssv:Parameter name="KqMO_PBAT_gain">
      <ssv:Real value="1" />
