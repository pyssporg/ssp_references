<?xml version='1.0' encoding='utf-8'?>
<ssd:SystemStructureDescription xmlns:ssc="http://ssp-standard.org/SSP1/SystemStructureCommon" xmlns:ssd="http://ssp-standard.org/SSP1/SystemStructureDescription" name="Dahlquist" version="1.0">
  <ssd:System name="Dahlquist">
    <ssd:Elements>
      <ssd:Component name="fmu" source="resources/model.fmu" type="application/x-fmu-sharedlibrary" implementation="CoSimulation">
        <ssd:Connectors>
          <ssd:Connector name="k" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="x" kind="output">
