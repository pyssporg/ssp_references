<?xml version='1.0' encoding='utf-8'?>
<ssd:SystemStructureDescription xmlns:ssc="http://ssp-standard.org/SSP1/SystemStructureCommon" xmlns:ssd="http://ssp-standard.org/SSP1/SystemStructureDescription" name="SystemStructure" version="1.0">
  <ssd:System name="system">
    <ssd:ParameterBindings>
      <ssd:ParameterBinding source="resources/vanderpol_parameters_fast.ssv">
        <ssd:ParameterMapping source="resources/vanderpol_parameters.ssm" />
      </ssd:ParameterBinding>
    </ssd:ParameterBindings>
    <ssd:Elements>
      <ssd:Component name="fmu" source="resources/VanDerPol.fmu" type="application/x-fmu-sharedlibrary" implementation="CoSimulation">
        <ssd:Connectors>
          <ssd:Connector name="mu" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="x0" kind="output">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="x1" kind="output">
            <ssc:Real />
          </ssd:Connector>
        </ssd:Connectors>
      </ssd:Component>
    </ssd:Elements>
  </ssd:System>
</ssd:SystemStructureDescription>