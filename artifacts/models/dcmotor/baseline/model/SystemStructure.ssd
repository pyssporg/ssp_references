<?xml version='1.0' encoding='utf-8'?>
<ssd:SystemStructureDescription xmlns:ssc="http://ssp-standard.org/SSP1/SystemStructureCommon" xmlns:ssd="http://ssp-standard.org/SSP1/SystemStructureDescription" xmlns:ssv="http://ssp-standard.org/SSP1/SystemStructureParameterValues" name="DC-Motor" version="1.0">
  <ssd:System name="DC-Motor">
    <ssd:Connectors>
      <ssd:Connector name="M_mot" kind="output" description="">
        <ssc:Real unit="Nm" />
      </ssd:Connector>
      <ssd:Connector name="wB" kind="output">
        <ssc:Real />
      </ssd:Connector>
      <ssd:Connector name="U" kind="output">
        <ssc:Real />
      </ssd:Connector>
      <ssd:Connector name="I" kind="output">
        <ssc:Real />
      </ssd:Connector>
      <ssd:Connector name="M_load" kind="output" description="">
        <ssc:Real unit="Nm" />
      </ssd:Connector>
    </ssd:Connectors>
    <ssd:ParameterBindings>
      <ssd:ParameterBinding>
        <ssd:ParameterValues>
          <ssv:ParameterSet version="2.0" name="Parameter-Set">
            <ssv:Parameters />
          </ssv:ParameterSet>
        </ssd:ParameterValues>
      </ssd:ParameterBinding>
      <ssd:ParameterBinding>
        <ssd:ParameterValues>
          <ssv:ParameterSet version="2.0" name="Parameter-Set">
            <ssv:Parameters />
          </ssv:ParameterSet>
        </ssd:ParameterValues>
      </ssd:ParameterBinding>
    </ssd:ParameterBindings>
    <ssd:Elements>
      <ssd:Component name="SuT_edrive_mass" source="resources/edrive_mass.fmu" type="application/x-fmu-sharedlibrary" implementation="CoSimulation">
        <ssd:Connectors>
          <ssd:Connector name="M_A" kind="input">
            <ssc:Real unit="N.m" />
          </ssd:Connector>
          <ssd:Connector name="phiB" kind="output">
            <ssc:Real unit="rad" />
          </ssd:Connector>
          <ssd:Connector name="wB" kind="output">
            <ssc:Real unit="rad/s" />
          </ssd:Connector>
          <ssd:Connector name="wA" kind="output">
            <ssc:Real unit="rad/s" />
          </ssd:Connector>
          <ssd:Connector name="M_B" kind="input">
            <ssc:Real unit="N.m" />
          </ssd:Connector>
          <ssd:Connector name="phiA" kind="output">
            <ssc:Real unit="rad" />
          </ssd:Connector>
        </ssd:Connectors>
        <ssd:ParameterBindings>
          <ssd:ParameterBinding>
            <ssd:ParameterValues>
              <ssv:ParameterSet version="2.0" name="Parameter-Set">
                <ssv:Parameters>
                  <ssv:Parameter name="inertia.J" description="Moment of inertia">
                    <ssv:Real value="0.002" unit="kg.m2" />
                  </ssv:Parameter>
                  <ssv:Parameter name="damper.d" description="Damping constant">
                    <ssv:Real value="0.001" unit="N.m.s/rad" />
                  </ssv:Parameter>
                </ssv:Parameters>
                <ssv:Units>
                  <ssc:Unit name="N.m.s/rad">
                    <ssc:BaseUnit kg="1" m="2" s="-1" A="0" K="0" mol="0" cd="0" rad="-1" factor="1.0" offset="0.0" />
                  </ssc:Unit>
                  <ssc:Unit name="kg.m2">
                    <ssc:BaseUnit kg="1" m="2" s="0" A="0" K="0" mol="0" cd="0" rad="0" factor="1.0" offset="0.0" />
                  </ssc:Unit>
                </ssv:Units>
              </ssv:ParameterSet>
            </ssd:ParameterValues>
          </ssd:ParameterBinding>
        </ssd:ParameterBindings>
      </ssd:Component>
      <ssd:Component name="SuT_emachine_model" source="resources/emachine_model.fmu" type="application/x-fmu-sharedlibrary" implementation="CoSimulation">
        <ssd:Connectors>
          <ssd:Connector name="M" kind="output">
            <ssc:Real unit="N.m" />
          </ssd:Connector>
          <ssd:Connector name="U" kind="input">
            <ssc:Real unit="V" />
          </ssd:Connector>
          <ssd:Connector name="w" kind="input">
            <ssc:Real unit="rad/s" />
          </ssd:Connector>
          <ssd:Connector name="phi" kind="input">
            <ssc:Real unit="rad" />
          </ssd:Connector>
          <ssd:Connector name="I" kind="output">
            <ssc:Real unit="A" />
          </ssd:Connector>
        </ssd:Connectors>
        <ssd:ParameterBindings>
          <ssd:ParameterBinding>
            <ssd:ParameterValues>
              <ssv:ParameterSet version="2.0" name="Parameter-Set">
                <ssv:Parameters>
                  <ssv:Parameter name="resistor.T_ref" description="Reference temperature">
                    <ssv:Real value="300.15" unit="K" />
                  </ssv:Parameter>
                  <ssv:Parameter name="resistor.T" description="Fixed device temperature if useHeatPort = false">
                    <ssv:Real value="300.15" unit="K" />
                  </ssv:Parameter>
                  <ssv:Parameter name="resistor.alpha" description="Temperature coefficient of resistance (R_actual = R*(1 + alpha*(T_heatPort - T_ref))">
                    <ssv:Real value="0.0" unit="1/K" />
                  </ssv:Parameter>
                  <ssv:Parameter name="inductor.L" description="Inductance">
                    <ssv:Real value="0.001" unit="H" />
                  </ssv:Parameter>
                  <ssv:Parameter name="emf.k" description="Transformation coefficient">
                    <ssv:Real value="0.1" unit="N.m/A" />
                  </ssv:Parameter>
                  <ssv:Parameter name="resistor.R" description="Resistance at temperature T_ref">
                    <ssv:Real value="0.5" unit="Ohm" />
                  </ssv:Parameter>
                </ssv:Parameters>
                <ssv:Units>
                  <ssc:Unit name="N.m/A">
                    <ssc:BaseUnit kg="1" m="2" s="-2" A="-1" K="0" mol="0" cd="0" rad="0" factor="1.0" offset="0.0" />
                  </ssc:Unit>
                  <ssc:Unit description="Temperature in Kelvin" name="K">
                    <ssc:BaseUnit kg="0" m="0" s="0" A="0" K="1" mol="0" cd="0" rad="0" factor="1.0" offset="0.0" />
                  </ssc:Unit>
                  <ssc:Unit name="Ohm">
                    <ssc:BaseUnit kg="1" m="2" s="-3" A="-2" K="0" mol="0" cd="0" rad="0" factor="1.0" offset="0.0" />
                  </ssc:Unit>
                  <ssc:Unit name="H">
                    <ssc:BaseUnit kg="1" m="2" s="-2" A="-2" K="0" mol="0" cd="0" rad="0" factor="1.0" offset="0.0" />
                  </ssc:Unit>
                  <ssc:Unit name="1/K">
                    <ssc:BaseUnit kg="0" m="0" s="0" A="0" K="-1" mol="0" cd="0" rad="0" factor="1.0" offset="0.0" />
                  </ssc:Unit>
                </ssv:Units>
              </ssv:ParameterSet>
            </ssd:ParameterValues>
          </ssd:ParameterBinding>
        </ssd:ParameterBindings>
      </ssd:Component>
      <ssd:Component name="stimuli_model" source="resources/stimuli_model.fmu" type="application/x-fmu-sharedlibrary" implementation="CoSimulation">
        <ssd:Connectors>
          <ssd:Connector name="U" kind="output">
            <ssc:Real unit="V" />
          </ssd:Connector>
          <ssd:Connector name="M_load" kind="output">
            <ssc:Real unit="N.m" />
          </ssd:Connector>
        </ssd:Connectors>
        <ssd:ParameterBindings>
          <ssd:ParameterBinding>
            <ssd:ParameterValues>
              <ssv:ParameterSet version="2.0" name="Parameter-Set">
                <ssv:Parameters>
                  <ssv:Parameter name="Voltage_step.offset" description="Offset of output signal y">
                    <ssv:Real value="0.0" />
                  </ssv:Parameter>
                  <ssv:Parameter name="Voltage_step.startTime" description="Output y = offset for time &lt; startTime">
                    <ssv:Real value="0.0" unit="s" />
                  </ssv:Parameter>
                  <ssv:Parameter name="Voltage_step.height" description="Height of step">
                    <ssv:Real value="12.0" unit="V" />
                  </ssv:Parameter>
                  <ssv:Parameter name="MLoad.k" description="Constant output value">
                    <ssv:Real value="-0.5" unit="N.m" />
                  </ssv:Parameter>
                </ssv:Parameters>
                <ssv:Units>
                  <ssc:Unit name="V">
                    <ssc:BaseUnit kg="1" m="2" s="-3" A="-1" K="0" mol="0" cd="0" rad="0" factor="1.0" offset="0.0" />
                  </ssc:Unit>
                  <ssc:Unit name="N.m">
                    <ssc:BaseUnit kg="1" m="2" s="-2" A="0" K="0" mol="0" cd="0" rad="0" factor="1.0" offset="0.0" />
                  </ssc:Unit>
                  <ssc:Unit description="Time in seconds" name="s">
                    <ssc:BaseUnit kg="0" m="0" s="1" A="0" K="0" mol="0" cd="0" rad="0" factor="1.0" offset="0.0" />
                  </ssc:Unit>
                </ssv:Units>
              </ssv:ParameterSet>
            </ssd:ParameterValues>
          </ssd:ParameterBinding>
        </ssd:ParameterBindings>
      </ssd:Component>
    </ssd:Elements>
    <ssd:Connections>
      <ssd:Connection startElement="SuT_emachine_model" startConnector="M" endConnector="M_mot" />
      <ssd:Connection startElement="SuT_edrive_mass" startConnector="wB" endConnector="wB" />
      <ssd:Connection startElement="stimuli_model" startConnector="U" endConnector="U" />
      <ssd:Connection startElement="SuT_emachine_model" startConnector="I" endConnector="I" />
      <ssd:Connection startElement="stimuli_model" startConnector="M_load" endElement="SuT_edrive_mass" endConnector="M_B" />
      <ssd:Connection startElement="stimuli_model" startConnector="U" endElement="SuT_emachine_model" endConnector="U" />
      <ssd:Connection startConnector="M_load" endElement="stimuli_model" endConnector="M_load" />
      <ssd:Connection startElement="SuT_emachine_model" startConnector="M" endElement="SuT_edrive_mass" endConnector="M_A" />
      <ssd:Connection startElement="SuT_edrive_mass" startConnector="wA" endElement="SuT_emachine_model" endConnector="w" />
      <ssd:Connection startElement="SuT_edrive_mass" startConnector="phiA" endElement="SuT_emachine_model" endConnector="phi" />
    </ssd:Connections>
  </ssd:System>
</ssd:SystemStructureDescription>