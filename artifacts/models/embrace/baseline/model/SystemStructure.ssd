          <ssd:Connector name="pipeA.L" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="pipeB.L" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
        </ssd:Connectors>
      </ssd:Component>
      <ssd:Component name="ECS_SW" source="resources/ECS_SW.fmu" type="application/x-fmu-sharedlibrary" implementation="CoSimulation">
        <ssd:Connectors>
          <ssd:Connector name="Input.TLiquid" kind="input">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="Input.Aircraft_State" kind="input">
            <ssc:Integer />
          </ssd:Connector>
          <ssd:Connector name="TCoolingPack" kind="output">
            <ssc:Real />
          </ssd:Connector>
        </ssd:Connectors>
      </ssd:Component>
      <ssd:Component name="Consumer" source="resources/Consumer.fmu" type="application/x-fmu-sharedlibrary" implementation="CoSimulation">
        <ssd:Connectors>
          <ssd:Connector name="consumerRet.m" kind="input">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="consumerRet.hn" kind="input">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="consumerFeed.m" kind="input">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="consumerFeed.hn" kind="input">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="Alt" kind="input">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="Mach" kind="input">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="Tamb" kind="input">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="Pamb" kind="input">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="heatLoad" kind="input">
