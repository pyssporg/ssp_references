          <ssd:Connector name="inletTemp" kind="output">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="outletTemp" kind="output">
            <ssc:Real />
          </ssd:Connector>
        </ssd:Connectors>
      </ssd:Component>
      <ssd:Component name="Atmos" source="resources/Atmos.fmu" type="application/x-fmu-sharedlibrary" implementation="CoSimulation">
        <ssd:Connectors>
          <ssd:Connector name="Alt" kind="input">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="Ma" kind="input">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="Tamb" kind="output">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="Pamb" kind="output">
            <ssc:Real />
          </ssd:Connector>
        </ssd:Connectors>
