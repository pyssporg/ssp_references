<?xml version='1.0' encoding='utf-8'?>
<ssd:SystemStructureDescription xmlns:ssc="http://ssp-standard.org/SSP1/SystemStructureCommon" xmlns:ssd="http://ssp-standard.org/SSP1/SystemStructureDescription" xmlns:ssv="http://ssp-standard.org/SSP1/SystemStructureParameterValues" name="SystemStructure" version="1.0">
  <ssd:System name="system">
    <ssd:ParameterBindings>
      <ssd:ParameterBinding>
        <ssd:ParameterValues>
          <ssv:ParameterSet version="1.0" name="system_parameters">
            <ssv:Parameters>
              <ssv:Parameter name="sink.k">
                <ssv:Real value="1.0" />
              </ssv:Parameter>
            </ssv:Parameters>
          </ssv:ParameterSet>
        </ssd:ParameterValues>
      </ssd:ParameterBinding>
    </ssd:ParameterBindings>
    <ssd:Elements>
      <ssd:Component name="source" source="resources/CsvSource.fmu" type="application/x-fmu-sharedlibrary" implementation="CoSimulation">
        <ssd:Connectors>
          <ssd:Connector name="csv_path" kind="parameter">
            <ssc:String />
          </ssd:Connector>
          <ssd:Connector name="y" kind="output">
            <ssc:Real />
          </ssd:Connector>
        </ssd:Connectors>
      </ssd:Component>
      <ssd:Component name="sink" source="resources/Gain.fmu" type="application/x-fmu-sharedlibrary" implementation="CoSimulation">
        <ssd:Connectors>
          <ssd:Connector name="k" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="u" kind="input">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="y" kind="output">
            <ssc:Real />
          </ssd:Connector>
        </ssd:Connectors>
      </ssd:Component>
    </ssd:Elements>
    <ssd:Connections>
      <ssd:Connection startElement="source" startConnector="y" endElement="sink" endConnector="u" />
    </ssd:Connections>
  </ssd:System>
  <ssd:DefaultExperiment startTime="0.0" stopTime="1.0" />
</ssd:SystemStructureDescription>