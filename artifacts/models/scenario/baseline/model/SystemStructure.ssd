<?xml version='1.0' encoding='utf-8'?>
<ssd:SystemStructureDescription xmlns:ssc="http://ssp-standard.org/SSP1/SystemStructureCommon" xmlns:ssd="http://ssp-standard.org/SSP1/SystemStructureDescription" xmlns:ssm="http://ssp-standard.org/SSP1/SystemStructureParameterMapping" name="System" version="1.0">
  <ssd:System name="System">
    <ssd:ParameterBindings>
      <ssd:ParameterBinding source="resources/parameter_sets/ScenarioSet.ssv">
        <ssd:ParameterMapping>
          <ssm:ParameterMapping version="1.0">
            <ssm:MappingEntry source="scenario_input" target="scenario.scenario_input" />
          </ssm:ParameterMapping>
        </ssd:ParameterMapping>
      </ssd:ParameterBinding>
    </ssd:ParameterBindings>
    <ssd:Elements>
      <ssd:Component name="scenario" source="resources/Scenario.fmu" type="application/x-fmu-sharedlibrary" implementation="CoSimulation">
        <ssd:Connectors>
          <ssd:Connector name="Alt" kind="output">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="Mach" kind="output">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="heat_load" kind="output">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="Wgt_On_Whl" kind="output">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="Aircraft_state" kind="output">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="scenario_input" kind="parameter">
            <ssc:String />
          </ssd:Connector>
        </ssd:Connectors>
      </ssd:Component>
    </ssd:Elements>
  </ssd:System>
  <ssd:DefaultExperiment startTime="0.0" stopTime="10.0" />
</ssd:SystemStructureDescription>