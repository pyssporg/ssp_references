<?xml version='1.0' encoding='utf-8'?>
<ssv:ParameterSet xmlns:ssv="http://ssp-standard.org/SSP1/SystemStructureParameterValues" version="1.0" name="signal_delay_detector_parameters">
  <ssv:Parameters>
    <ssv:Parameter name="step.height">
      <ssv:Real value="1.0" />
    </ssv:Parameter>
    <ssv:Parameter name="step.offset">
      <ssv:Real value="0.5" />
    </ssv:Parameter>
    <ssv:Parameter name="step.startTime">
      <ssv:Real value="0.25" />
    </ssv:Parameter>
    <ssv:Parameter name="gain_a.k">
      <ssv:Real value="1.0" />
    </ssv:Parameter>
    <ssv:Parameter name="gain_b.k">
      <ssv:Real value="1.0" />
    </ssv:Parameter>
    <ssv:Parameter name="add.k1">
      <ssv:Real value="1.0" />
    </ssv:Parameter>
    <ssv:Parameter name="add.k2">
      <ssv:Real value="-1.0" />
    </ssv:Parameter>
  </ssv:Parameters>
</ssv:ParameterSet>