<?xml version='1.0' encoding='utf-8'?>
<ssd:SystemStructureDescription xmlns:ssc="http://ssp-standard.org/SSP1/SystemStructureCommon" xmlns:ssd="http://ssp-standard.org/SSP1/SystemStructureDescription" name="SystemStructure" version="1.0">
  <ssd:System name="system">
    <ssd:ParameterBindings>
      <ssd:ParameterBinding source="resources/signal_nested_algebraic_loop_parameters.ssv" />
    </ssd:ParameterBindings>
    <ssd:Elements>
      <ssd:Component name="sine" source="resources/Sine.fmu" type="application/x-fmu-sharedlibrary" implementation="CoSimulation">
        <ssd:Connectors>
          <ssd:Connector name="amplitude" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="f" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="offset" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="phase" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="startTime" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="y" kind="output">
            <ssc:Real />
          </ssd:Connector>
        </ssd:Connectors>
      </ssd:Component>
      <ssd:Component name="gain_outer" source="resources/GainOuter.fmu" type="application/x-fmu-sharedlibrary" implementation="CoSimulation">
        <ssd:Connectors>
          <ssd:Connector name="k" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="u" kind="input">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="y" kind="output">
            <ssc:Real />
          </ssd:Connector>
        </ssd:Connectors>
      </ssd:Component>
      <ssd:Component name="gain_inner" source="resources/GainInner.fmu" type="application/x-fmu-sharedlibrary" implementation="CoSimulation">
        <ssd:Connectors>
          <ssd:Connector name="k" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="u" kind="input">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="y" kind="output">
            <ssc:Real />
          </ssd:Connector>
        </ssd:Connectors>
      </ssd:Component>
      <ssd:Component name="add_outer" source="resources/AddOuter.fmu" type="application/x-fmu-sharedlibrary" implementation="CoSimulation">
        <ssd:Connectors>
          <ssd:Connector name="k1" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="k2" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="u1" kind="input">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="u2" kind="input">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="y" kind="output">
            <ssc:Real />
          </ssd:Connector>
        </ssd:Connectors>
      </ssd:Component>
      <ssd:Component name="add_inner" source="resources/AddInner.fmu" type="application/x-fmu-sharedlibrary" implementation="CoSimulation">
        <ssd:Connectors>
          <ssd:Connector name="k1" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="k2" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="u1" kind="input">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="u2" kind="input">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="y" kind="output">
            <ssc:Real />
          </ssd:Connector>
        </ssd:Connectors>
      </ssd:Component>
    </ssd:Elements>
    <ssd:Connections>
      <ssd:Connection startElement="sine" startConnector="y" endElement="add_outer" endConnector="u1" />
      <ssd:Connection startElement="add_inner" startConnector="y" endElement="add_outer" endConnector="u2" />
      <ssd:Connection startElement="add_outer" startConnector="y" endElement="gain_outer" endConnector="u" />
      <ssd:Connection startElement="gain_outer" startConnector="y" endElement="add_inner" endConnector="u1" />
      <ssd:Connection startElement="gain_inner" startConnector="y" endElement="add_inner" endConnector="u2" />
      <ssd:Connection startElement="add_inner" startConnector="y" endElement="gain_inner" endConnector="u" />
    </ssd:Connections>
  </ssd:System>
  <ssd:DefaultExperiment startTime="0.0" stopTime="1.0" />
</ssd:SystemStructureDescription>