<?xml version='1.0' encoding='utf-8'?>
<ssd:SystemStructureDescription xmlns:ssc="http://ssp-standard.org/SSP1/SystemStructureCommon" xmlns:ssd="http://ssp-standard.org/SSP1/SystemStructureDescription" xmlns:ssv="http://ssp-standard.org/SSP1/SystemStructureParameterValues" name="SystemStructure" version="1.0">
  <ssd:System name="system">
    <ssd:ParameterBindings>
      <ssd:ParameterBinding>
        <ssd:ParameterValues>
          <ssv:ParameterSet version="1.0" name="system_parameters">
            <ssv:Parameters>
              <ssv:Parameter name="sine.amplitude">
                <ssv:Real value="1.0" />
              </ssv:Parameter>
              <ssv:Parameter name="sine.f">
                <ssv:Real value="1.0" />
              </ssv:Parameter>
              <ssv:Parameter name="sine.offset">
                <ssv:Real value="0.0" />
              </ssv:Parameter>
              <ssv:Parameter name="sine.phase">
                <ssv:Real value="0.0" />
              </ssv:Parameter>
              <ssv:Parameter name="sine.startTime">
                <ssv:Real value="0.0" />
              </ssv:Parameter>
              <ssv:Parameter name="step.height">
                <ssv:Real value="2.0" />
              </ssv:Parameter>
              <ssv:Parameter name="step.offset">
                <ssv:Real value="0.0" />
              </ssv:Parameter>
              <ssv:Parameter name="step.startTime">
                <ssv:Real value="0.5" />
              </ssv:Parameter>
              <ssv:Parameter name="gain.k">
                <ssv:Real value="3.0" />
              </ssv:Parameter>
              <ssv:Parameter name="add.k1">
                <ssv:Real value="1.0" />
              </ssv:Parameter>
              <ssv:Parameter name="add.k2">
                <ssv:Real value="1.0" />
              </ssv:Parameter>
            </ssv:Parameters>
          </ssv:ParameterSet>
        </ssd:ParameterValues>
      </ssd:ParameterBinding>
    </ssd:ParameterBindings>
    <ssd:Elements>
      <ssd:Component name="sine" source="resources/Sine.fmu" type="application/x-fmu-sharedlibrary" implementation="CoSimulation">
        <ssd:Connectors>
          <ssd:Connector name="amplitude" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="f" kind="parameter">
            <ssc:Real unit="Hz" />
          </ssd:Connector>
          <ssd:Connector name="offset" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="phase" kind="parameter">
            <ssc:Real unit="rad" />
          </ssd:Connector>
          <ssd:Connector name="startTime" kind="parameter">
            <ssc:Real unit="s" />
          </ssd:Connector>
          <ssd:Connector name="y" kind="output">
            <ssc:Real />
          </ssd:Connector>
        </ssd:Connectors>
      </ssd:Component>
      <ssd:Component name="step" source="resources/Step.fmu" type="application/x-fmu-sharedlibrary" implementation="CoSimulation">
        <ssd:Connectors>
          <ssd:Connector name="height" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="offset" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="startTime" kind="parameter">
            <ssc:Real unit="s" />
          </ssd:Connector>
          <ssd:Connector name="y" kind="output">
            <ssc:Real />
          </ssd:Connector>
        </ssd:Connectors>
      </ssd:Component>
      <ssd:Component name="gain" source="resources/Gain.fmu" type="application/x-fmu-sharedlibrary" implementation="CoSimulation">
        <ssd:Connectors>
          <ssd:Connector name="k" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="u" kind="input">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="y" kind="output">
            <ssc:Real />
          </ssd:Connector>
        </ssd:Connectors>
      </ssd:Component>
      <ssd:Component name="add" source="resources/Add.fmu" type="application/x-fmu-sharedlibrary" implementation="CoSimulation">
        <ssd:Connectors>
          <ssd:Connector name="k1" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="k2" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="u1" kind="input">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="u2" kind="input">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="y" kind="output">
            <ssc:Real />
          </ssd:Connector>
        </ssd:Connectors>
      </ssd:Component>
    </ssd:Elements>
    <ssd:Connections>
      <ssd:Connection startElement="sine" startConnector="y" endElement="gain" endConnector="u" />
      <ssd:Connection startElement="gain" startConnector="y" endElement="add" endConnector="u1" />
      <ssd:Connection startElement="step" startConnector="y" endElement="add" endConnector="u2" />
    </ssd:Connections>
  </ssd:System>
  <ssd:DefaultExperiment startTime="0.0" stopTime="1.0" />
</ssd:SystemStructureDescription>