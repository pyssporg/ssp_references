<?xml version='1.0' encoding='utf-8'?>
<ssd:SystemStructureDescription xmlns:ssc="http://ssp-standard.org/SSP1/SystemStructureCommon" xmlns:ssd="http://ssp-standard.org/SSP1/SystemStructureDescription" name="System" version="1.0">
  <ssd:System name="System">
    <ssd:ParameterBindings>
      <ssd:ParameterBinding source="resources/ScenarioSet.ssv">
        <ssd:ParameterMapping source="resources/step_two.ssm" />
      </ssd:ParameterBinding>
    </ssd:ParameterBindings>
    <ssd:Elements>
      <ssd:Component name="source" source="resources/Step.fmu" type="application/x-fmu-sharedlibrary" implementation="CoSimulation">
        <ssd:Connectors>
          <ssd:Connector name="y" kind="output">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="height" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="offset" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="startTime" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
        </ssd:Connectors>
      </ssd:Component>
      <ssd:System name="gain">
        <ssd:Connectors>
          <ssd:Connector name="u" kind="input">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="y" kind="output">
            <ssc:Real />
          </ssd:Connector>
        </ssd:Connectors>
        <ssd:Elements>
          <ssd:Component name="firstStage" source="resources/Gain.fmu" type="application/x-fmu-sharedlibrary" implementation="CoSimulation">
            <ssd:Connectors>
              <ssd:Connector name="u" kind="input">
                <ssc:Real />
              </ssd:Connector>
              <ssd:Connector name="y" kind="output">
                <ssc:Real />
              </ssd:Connector>
              <ssd:Connector name="k" kind="parameter">
                <ssc:Real />
              </ssd:Connector>
            </ssd:Connectors>
          </ssd:Component>
          <ssd:Component name="secondStage" source="resources/Gain.fmu" type="application/x-fmu-sharedlibrary" implementation="CoSimulation">
            <ssd:Connectors>
              <ssd:Connector name="u" kind="input">
                <ssc:Real />
              </ssd:Connector>
              <ssd:Connector name="y" kind="output">
                <ssc:Real />
              </ssd:Connector>
              <ssd:Connector name="k" kind="parameter">
                <ssc:Real />
              </ssd:Connector>
            </ssd:Connectors>
          </ssd:Component>
        </ssd:Elements>
        <ssd:Connections>
          <ssd:Connection startConnector="u" endElement="firstStage" endConnector="u" />
          <ssd:Connection startElement="firstStage" startConnector="y" endElement="secondStage" endConnector="u" />
          <ssd:Connection startElement="secondStage" startConnector="y" endConnector="y" />
        </ssd:Connections>
      </ssd:System>
    </ssd:Elements>
    <ssd:Connections>
      <ssd:Connection startElement="source" startConnector="y" endElement="gain" endConnector="u" />
    </ssd:Connections>
  </ssd:System>
  <ssd:DefaultExperiment startTime="0.0" stopTime="1.0" />
</ssd:SystemStructureDescription>