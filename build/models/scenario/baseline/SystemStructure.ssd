<?xml version='1.0' encoding='utf-8'?>
<ssd:SystemStructureDescription xmlns:ssc="http://ssp-standard.org/SSP1/SystemStructureCommon" xmlns:ssd="http://ssp-standard.org/SSP1/SystemStructureDescription" name="model" version="1.0">
  <ssd:System name="root">
    <ssd:ParameterBindings>
      <ssd:ParameterBinding source="resources/init_values.ssv">
        <ssd:ParameterMapping source="resources/init_values.ssm" />
      </ssd:ParameterBinding>
      <ssd:ParameterBinding source="resources/init_values.ssv">
        <ssd:ParameterMapping source="resources/init_values.ssm" />
      </ssd:ParameterBinding>
    </ssd:ParameterBindings>
    <ssd:Elements>
      <ssd:Component name="scenario" source="resources/0001_scenario.fmu" type="application/x-fmu-sharedlibrary">
        <ssd:Connectors>
          <ssd:Connector name="Alt" kind="output">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="Mach" kind="output">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="heat_load" kind="output">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="Wgt_On_Whl" kind="output">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="Aircraft_state" kind="output">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="scenario_input" kind="parameter">
            <ssc:String />
          </ssd:Connector>
        </ssd:Connectors>
      </ssd:Component>
    </ssd:Elements>
  </ssd:System>
  <ssd:DefaultExperiment startTime="0.0" stopTime="1.0" />
</ssd:SystemStructureDescription>