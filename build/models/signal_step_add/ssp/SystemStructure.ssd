<?xml version='1.0' encoding='utf-8'?>
<ssd:SystemStructureDescription xmlns:ssc="http://ssp-standard.org/SSP1/SystemStructureCommon" xmlns:ssd="http://ssp-standard.org/SSP1/SystemStructureDescription" xmlns:ssv="http://ssp-standard.org/SSP1/SystemStructureParameterValues" name="SystemStructure" version="1.0">
  <ssd:System name="system">
    <ssd:ParameterBindings>
      <ssd:ParameterBinding>
        <ssd:ParameterValues>
          <ssv:ParameterSet version="1.0" name="system_parameters">
            <ssv:Parameters>
              <ssv:Parameter name="step_a.height">
                <ssv:Real value="1.5" />
              </ssv:Parameter>
              <ssv:Parameter name="step_a.offset">
                <ssv:Real value="0.5" />
              </ssv:Parameter>
              <ssv:Parameter name="step_a.startTime">
                <ssv:Real value="0.25" />
              </ssv:Parameter>
              <ssv:Parameter name="step_b.height">
                <ssv:Real value="-0.5" />
              </ssv:Parameter>
              <ssv:Parameter name="step_b.offset">
                <ssv:Real value="1.0" />
              </ssv:Parameter>
              <ssv:Parameter name="step_b.startTime">
                <ssv:Real value="0.5" />
              </ssv:Parameter>
              <ssv:Parameter name="add.k1">
                <ssv:Real value="1.0" />
              </ssv:Parameter>
              <ssv:Parameter name="add.k2">
                <ssv:Real value="1.0" />
              </ssv:Parameter>
            </ssv:Parameters>
          </ssv:ParameterSet>
        </ssd:ParameterValues>
      </ssd:ParameterBinding>
    </ssd:ParameterBindings>
    <ssd:Elements>
      <ssd:Component name="step_a" source="resources/StepA.fmu" type="application/x-fmu-sharedlibrary" implementation="CoSimulation">
        <ssd:Connectors>
          <ssd:Connector name="height" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="offset" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="startTime" kind="parameter">
            <ssc:Real unit="s" />
          </ssd:Connector>
          <ssd:Connector name="y" kind="output">
            <ssc:Real />
          </ssd:Connector>
        </ssd:Connectors>
      </ssd:Component>
      <ssd:Component name="step_b" source="resources/StepB.fmu" type="application/x-fmu-sharedlibrary" implementation="CoSimulation">
        <ssd:Connectors>
          <ssd:Connector name="height" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="offset" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="startTime" kind="parameter">
            <ssc:Real unit="s" />
          </ssd:Connector>
          <ssd:Connector name="y" kind="output">
            <ssc:Real />
          </ssd:Connector>
        </ssd:Connectors>
      </ssd:Component>
      <ssd:Component name="add" source="resources/Add.fmu" type="application/x-fmu-sharedlibrary" implementation="CoSimulation">
        <ssd:Connectors>
          <ssd:Connector name="k1" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="k2" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="u1" kind="input">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="u2" kind="input">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="y" kind="output">
            <ssc:Real />
          </ssd:Connector>
        </ssd:Connectors>
      </ssd:Component>
    </ssd:Elements>
    <ssd:Connections>
      <ssd:Connection startElement="step_a" startConnector="y" endElement="add" endConnector="u1" />
      <ssd:Connection startElement="step_b" startConnector="y" endElement="add" endConnector="u2" />
      <ssd:Connection startElement="step_a" startConnector="y" endConnector="step_a_y" />
      <ssd:Connection startElement="step_b" startConnector="y" endConnector="step_b_y" />
      <ssd:Connection startElement="add" startConnector="y" endConnector="sum_y" />
    </ssd:Connections>
  </ssd:System>
  <ssd:DefaultExperiment startTime="0.0" stopTime="1.0" />
</ssd:SystemStructureDescription>