<?xml version="1.0" encoding="UTF-8"?>
<Experiments
    name="VanDerPol LS-REF experiments"
    description="Two parameter-mapped VanDerPol experiments with separate references.">
  <Experiment
      name="baseline"
      description="Baseline configuration with mu set to 1.0."
      target="SystemStructure.ssd"
      startTime="0.0"
      stopTime="20.0"
      stepSize="0.001"
      tolerance="0.0001">
    <References
        source="references/VanDerPol-cs.csv"
        mapping="references/VanDerPol-cs.ssm">
      <Signal name="default.VanDerPol.x0" />
      <Signal name="default.VanDerPol.x1" />
    </References>
  </Experiment>
  <Experiment
      name="fast"
      description="Variant configuration with mu set to 2.0."
      target="SystemStructure.ssd"
      startTime="0.0"
      stopTime="1.0"
      stepSize="0.001"
      tolerance="0.0001">
    <Parameters
        source="resources/vanderpol_parameters_fast.ssv"
        mapping="resources/vanderpol_parameters.ssm" />
    <References
        source="resources/vanderpol_reference_fast.csv"
        mapping="resources/vanderpol_references.ssm">
      <Signal name="x0" />
      <Signal name="x1" />
    </References>
  </Experiment>
</Experiments>
