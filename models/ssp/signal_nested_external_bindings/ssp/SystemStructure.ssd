<?xml version="1.0" encoding="utf-8"?>
<ssd:SystemStructureDescription
  xmlns:ssc="http://ssp-standard.org/SSP1/SystemStructureCommon"
  xmlns:ssd="http://ssp-standard.org/SSP1/SystemStructureDescription"
  xmlns:ssv="http://ssp-standard.org/SSP1/SystemStructureParameterValues"
  name="SystemStructure"
  version="1.0">
  <ssd:System name="system">
    <ssd:Connectors>
      <ssd:Connector name="y" kind="output">
        <ssc:Real />
      </ssd:Connector>
    </ssd:Connectors>
    <ssd:Elements>
      <ssd:Component
        name="step"
        source="resources/Step.fmu"
        type="application/x-fmu-sharedlibrary"
        implementation="CoSimulation">
        <ssd:Connectors>
          <ssd:Connector name="height" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="offset" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="startTime" kind="parameter">
            <ssc:Real unit="s" />
          </ssd:Connector>
          <ssd:Connector name="y" kind="output">
            <ssc:Real />
          </ssd:Connector>
        </ssd:Connectors>
        <ssd:ParameterBindings>
          <ssd:ParameterBinding>
            <ssd:ParameterValues>
              <ssv:ParameterSet version="1.0" name="step_parameters">
                <ssv:Parameters>
                  <ssv:Parameter name="height">
                    <ssv:Real value="1.0" />
                  </ssv:Parameter>
                  <ssv:Parameter name="offset">
                    <ssv:Real value="0.0" />
                  </ssv:Parameter>
                  <ssv:Parameter name="startTime">
                    <ssv:Real value="0.25" />
                  </ssv:Parameter>
                </ssv:Parameters>
              </ssv:ParameterSet>
            </ssd:ParameterValues>
          </ssd:ParameterBinding>
        </ssd:ParameterBindings>
      </ssd:Component>
      <ssd:System name="inner">
        <ssd:Connectors>
          <ssd:Connector name="y" kind="output">
            <ssc:Real />
          </ssd:Connector>
        </ssd:Connectors>
        <ssd:ParameterBindings>
          <ssd:ParameterBinding source="resources/inner_parameters.ssv">
            <ssd:ParameterMapping source="resources/inner_mapping.ssm" />
          </ssd:ParameterBinding>
        </ssd:ParameterBindings>
        <ssd:Elements>
          <ssd:Component
            name="sine"
            source="resources/Sine.fmu"
            type="application/x-fmu-sharedlibrary"
            implementation="CoSimulation">
            <ssd:Connectors>
              <ssd:Connector name="amplitude" kind="parameter">
                <ssc:Real />
              </ssd:Connector>
              <ssd:Connector name="f" kind="parameter">
                <ssc:Real unit="Hz" />
              </ssd:Connector>
              <ssd:Connector name="offset" kind="parameter">
                <ssc:Real />
              </ssd:Connector>
              <ssd:Connector name="phase" kind="parameter">
                <ssc:Real unit="rad" />
              </ssd:Connector>
              <ssd:Connector name="startTime" kind="parameter">
                <ssc:Real unit="s" />
              </ssd:Connector>
              <ssd:Connector name="y" kind="output">
                <ssc:Real />
              </ssd:Connector>
            </ssd:Connectors>
          </ssd:Component>
        </ssd:Elements>
        <ssd:Connections>
          <ssd:Connection startElement="sine" startConnector="y" endConnector="y" />
        </ssd:Connections>
      </ssd:System>
    </ssd:Elements>
    <ssd:Connections>
      <ssd:Connection startElement="step" startConnector="y" endConnector="y" />
    </ssd:Connections>
  </ssd:System>
  <ssd:DefaultExperiment startTime="0.0" stopTime="1.0" />
</ssd:SystemStructureDescription>
