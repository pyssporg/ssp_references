<?xml version="1.0" encoding="utf-8"?>
<ssd:SystemStructureDescription
  xmlns:ssc="http://ssp-standard.org/SSP1/SystemStructureCommon"
  xmlns:ssd="http://ssp-standard.org/SSP1/SystemStructureDescription"
  xmlns:ssv="http://ssp-standard.org/SSP1/SystemStructureParameterValues"
  name="SystemStructure"
  version="1.0">
  <ssd:System name="system">
    <ssd:Connectors>
      <ssd:Connector name="y" kind="output">
        <ssc:Real />
      </ssd:Connector>
    </ssd:Connectors>
    <ssd:Elements>
      <ssd:Component
        name="step"
        source="resources/Step.fmu"
        type="application/x-fmu-sharedlibrary"
        implementation="CoSimulation">
        <ssd:Connectors>
          <ssd:Connector name="height" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="offset" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="startTime" kind="parameter">
            <ssc:Real unit="s" />
          </ssd:Connector>
          <ssd:Connector name="y" kind="output">
            <ssc:Real />
          </ssd:Connector>
        </ssd:Connectors>
        <ssd:ParameterBindings>
          <ssd:ParameterBinding>
            <ssd:ParameterValues>
              <ssv:ParameterSet version="1.0" name="step_parameters">
                <ssv:Parameters>
                  <ssv:Parameter name="height">
                    <ssv:Real value="1.0" />
                  </ssv:Parameter>
                  <ssv:Parameter name="offset">
                    <ssv:Real value="0.0" />
                  </ssv:Parameter>
                  <ssv:Parameter name="startTime">
                    <ssv:Real value="0.0" />
                  </ssv:Parameter>
                </ssv:Parameters>
              </ssv:ParameterSet>
            </ssd:ParameterValues>
          </ssd:ParameterBinding>
        </ssd:ParameterBindings>
      </ssd:Component>
      <ssd:Component
        name="add"
        source="resources/Add.fmu"
        type="application/x-fmu-sharedlibrary"
        implementation="CoSimulation">
        <ssd:Connectors>
          <ssd:Connector name="k1" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="k2" kind="parameter">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="u1" kind="input">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="u2" kind="input">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="y" kind="output">
            <ssc:Real />
          </ssd:Connector>
        </ssd:Connectors>
        <ssd:ParameterBindings>
          <ssd:ParameterBinding>
            <ssd:ParameterValues>
              <ssv:ParameterSet version="1.0" name="add_parameters">
                <ssv:Parameters>
                  <ssv:Parameter name="k1">
                    <ssv:Real value="1.0" />
                  </ssv:Parameter>
                  <ssv:Parameter name="k2">
                    <ssv:Real value="1.0" />
                  </ssv:Parameter>
                </ssv:Parameters>
              </ssv:ParameterSet>
            </ssd:ParameterValues>
          </ssd:ParameterBinding>
        </ssd:ParameterBindings>
      </ssd:Component>
      <ssd:System name="inner">
        <ssd:Connectors>
          <ssd:Connector name="in" kind="input">
            <ssc:Real />
          </ssd:Connector>
          <ssd:Connector name="out" kind="output">
            <ssc:Real />
          </ssd:Connector>
        </ssd:Connectors>
        <ssd:Elements>
          <ssd:Component
            name="gain"
            source="resources/Gain.fmu"
            type="application/x-fmu-sharedlibrary"
            implementation="CoSimulation">
            <ssd:Connectors>
              <ssd:Connector name="k" kind="parameter">
                <ssc:Real />
              </ssd:Connector>
              <ssd:Connector name="u" kind="input">
                <ssc:Real />
              </ssd:Connector>
              <ssd:Connector name="y" kind="output">
                <ssc:Real />
              </ssd:Connector>
            </ssd:Connectors>
            <ssd:ParameterBindings>
              <ssd:ParameterBinding>
                <ssd:ParameterValues>
                  <ssv:ParameterSet version="1.0" name="gain_parameters">
                    <ssv:Parameters>
                      <ssv:Parameter name="k">
                        <ssv:Real value="1.0" />
                      </ssv:Parameter>
                    </ssv:Parameters>
                  </ssv:ParameterSet>
                </ssd:ParameterValues>
              </ssd:ParameterBinding>
            </ssd:ParameterBindings>
          </ssd:Component>
        </ssd:Elements>
        <ssd:Connections>
          <ssd:Connection startConnector="in" endElement="gain" endConnector="u" />
          <ssd:Connection startElement="gain" startConnector="y" endConnector="out" />
        </ssd:Connections>
      </ssd:System>
    </ssd:Elements>
    <ssd:Connections>
      <ssd:Connection startElement="step" startConnector="y" endElement="inner" endConnector="in" />
      <ssd:Connection startElement="inner" startConnector="out" endElement="add" endConnector="u1" />
      <ssd:Connection startElement="add" startConnector="y" endConnector="y" />
    </ssd:Connections>
  </ssd:System>
  <ssd:DefaultExperiment startTime="0.0" stopTime="1.0" />
</ssd:SystemStructureDescription>
