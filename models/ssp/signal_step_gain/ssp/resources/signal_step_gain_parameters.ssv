<ssv:ParameterSet xmlns:ssv="http://ssp-standard.org/SSP1/SystemStructureParameterValues" version="1.0" name="signal_step_gain_parameters">
  <ssv:Parameters>
    <ssv:Parameter name="step.height">
      <ssv:Real value="2.0" />
    </ssv:Parameter>
    <ssv:Parameter name="step.offset">
      <ssv:Real value="1.0" />
    </ssv:Parameter>
    <ssv:Parameter name="step.startTime">
      <ssv:Real value="0.25" />
    </ssv:Parameter>
    <ssv:Parameter name="gain.k">
      <ssv:Real value="3.0" />
    </ssv:Parameter>
  </ssv:Parameters>
</ssv:ParameterSet>
